pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// ProveIt - ZK Credential Verification Protocol
// Author: Midas (@iamkingmelah)
// GitHub: github.com/iamkingmelah/proveit
// ============================================================
// A privacy-first credential verification protocol on Midnight.
// Proves eligibility without revealing underlying data.
// Architecture: Commit → Prove → Verify
// ============================================================


// ============================================================
// CHAPTER 1: CREDENTIAL DATA STRUCTURE
// Purpose: Define the on-chain public state of ProveIt.
// All variables here are visible on the blockchain.
// The actual private data (balance) never appears here.
// ============================================================

export ledger owner: Opaque<"string">;       // Wallet address of credential holder
export ledger threshold: Uint<64>;           // Minimum balance required to pass
export ledger commitment: Bytes<32>;  // Cryptographic hash of private data
export ledger verified: Boolean;             // Final result: true = eligible


// ============================================================
// CHAPTER 2: COMMIT CIRCUIT
// Purpose: Take private credential data and commit it
// to the blockchain without revealing the underlying values.
// The user provides a pre-hashed commitment from off-chain.
// Think: sealing an envelope before handing it over.
// ============================================================

export circuit commitCredential(
  rawBalance: Uint<64>,                    // Raw private balance — never disclosed
  ownerAddress: Opaque<"string">,          // Wallet address of the prover
  minimumThreshold: Uint<64>              // Minimum balance required
): [] {
  // Hash the raw balance inside the ZK circuit
  // Cannot be faked — hashing happens inside the proof
  commitment = disclose(persistentHash<Uint<64>>(rawBalance));
  owner = disclose(ownerAddress);                    // Store owner publicly
  threshold = disclose(minimumThreshold);            // Store threshold publicly
  verified = false;                                  // Reset verification state
}

//============================================================
// CHAPTER 3: WITNESS 
// Purpose: Define the private inputs only the prover knows.
// The witness is NEVER stored on-chain or revealed publicly.
// It exists only during proof generation then disappears.
// Think: the secret testimony that validates the sealed envelope.
// ==========================================================
witness actualBalance(): Uint<64>;


// ============================================================
// CHAPTER 4: PROOF CIRCUIT
// Purpose: Prove the private balance meets the threshold
// without revealing the actual balance.
// This is the zero-knowledge proof — the core of ProveIt.
// Think: the judge who hears private testimony and delivers
// a public verdict without revealing what was said.
// ============================================================

export circuit proveEligibility(): [] {
  // Retrieve the private balance from the witness
  // This value NEVER leaves the prover's machine
  const balance = actualBalance();

  // Compare private balance against public threshold
  // This comparison is what gets proven cryptographically
  assert (balance >= threshold,
    "Balance does not meet the required threshold");

  // If assertion passes — mark as verified publicly
  verified = true;
}