pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================
// ProveIt - ZK Credential Verification Protocol
// Author: Midas (@iamkingmelah)
// GitHub: github.com/iamkingmelah/proveit
// ============================================================
// A privacy-first credential verification protocol on Midnight.
// Proves eligibility without revealing underlying data.
// Architecture: Commit → Prove → Verify
// ============================================================


// ============================================================
// CHAPTER 1: CREDENTIAL DATA STRUCTURE (Multi-User)
// Purpose: Define the on-chain public state of ProveIt.
// All variables here are visible on the blockchain.
// The actual private data (balance) never appears here.
//
// Updated for multi-user support: each field is now a Map
// keyed by the credential owner's address, so multiple users
// can commit and verify independently without overwriting
// each other's state. The owner's address itself becomes the
// map key — no separate `owner` field is needed anymore.
// ============================================================

export ledger thresholds: Map<Opaque<"string">, Uint<64>>;      // Per-user minimum balance required to pass
export ledger commitments: Map<Opaque<"string">, Bytes<32>>;    // Per-user cryptographic hash of private data
export ledger verified: Map<Opaque<"string">, Boolean>;         // Per-user final result: true = eligible


// ============================================================
// CHAPTER 2: COMMIT CIRCUIT
// Purpose: Take private credential data and commit it
// to the blockchain without revealing the underlying values.
// The user provides a pre-hashed commitment from off-chain.
// Think: sealing an envelope before handing it over.
// ============================================================

export circuit commitCredential(
  rawBalance: Uint<64>,                 // Private — never disclosed
  ownerAddress: Opaque<"string">,       // Public
  minimumThreshold: Uint<64>           // Public
): [] {
  // Recompute hash inside the circuit to verify it's genuine
  const computedHash = persistentHash<Uint<64>>(rawBalance);

  // Store per-user data, keyed by owner address.
  // Re-committing always resets verified to false — this is intentional:
  // a fresh commitment always requires a fresh proof, so there's never
  // a stale "verified: true" left over from an outdated credential.
  commitments.insert(disclose(ownerAddress), disclose(computedHash));
  thresholds.insert(disclose(ownerAddress), disclose(minimumThreshold));
  verified.insert(disclose(ownerAddress), disclose(false));
}

//============================================================
// CHAPTER 3: WITNESS 
// Purpose: Define the private inputs only the prover knows.
// The witness is NEVER stored on-chain or revealed publicly.
// It exists only during proof generation then disappears.
// Think: the secret testimony that validates the sealed envelope.
// ==========================================================
witness actualBalance(): Uint<64>;


// ============================================================
// CHAPTER 4: PROOF CIRCUIT
// Purpose: Prove the private balance meets the threshold
// without revealing the actual balance.
// This is the zero-knowledge proof — the core of ProveIt.
// Think: the judge who hears private testimony and delivers
// a public verdict without revealing what was said.
// ============================================================

export circuit proveEligibility(ownerAddress: Opaque<"string">): [] {
  const balance = actualBalance();

  assert(thresholds.member(disclose(ownerAddress)), "No credential committed for this address");

  const requiredThreshold = thresholds.lookup(disclose(ownerAddress));
  assert(balance >= requiredThreshold,
  "Balance does not meet the required threshold");

  const recomputed = persistentHash<Uint<64>>(balance);
  const storedCommitment = commitments.lookup(disclose(ownerAddress));
  assert(recomputed == storedCommitment, "Proof is stale");

  verified.insert(disclose(ownerAddress), disclose(true));
}

// ============================================================
// CHAPTER 5: VERIFIER
// Purpose: Public-facing verification function.
// This is what other DApps import and call.
// It reads the public verified state and returns the result.
// No private data involved — purely public state check.
// Think: the bouncer who checks the stamp, not the balance.
// This is what makes ProveIt infrastructure, not just a contract.
//
// Updated for multi-user support: now takes an ownerAddress
// parameter, since verification status is no longer a single
// global value — each user has their own independent entry.
// A lending dApp (or any consumer) can now correctly ask
// "is THIS specific user verified?" instead of only being able
// to check whichever credential was most recently proven.
//
// If the address has never committed a credential at all,
// this returns false rather than erroring — a safe default
// for anyone who hasn't interacted with ProveIt yet.
// ============================================================

export circuit verifyCredential(ownerAddress: Opaque<"string">): Boolean {
  // Return this specific user's verification status.
  // true = this address's credential has been proven eligible
  // false = not yet proven, failed, or no credential exists for this address
  if (verified.member(disclose(ownerAddress))) {
    return disclose(verified.lookup(disclose(ownerAddress)));
  }
  return false;
}